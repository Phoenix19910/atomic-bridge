# ==============================================================================
# AtomicBridge Backend Environment Configuration
# ==============================================================================

# Server Network Configuration
# Set HOST to 0.0.0.0 to enable mobile phone & cross-device browser testing on the local Wi-Fi / LAN
PORT=4000
HOST=0.0.0.0

# Hyperledger Fabric Corridor Channel & Chaincode
CHANNEL_NAME=corridor-channel
CHAINCODE_NAME=atomicbridge

# Path to generated crypto-material organizations directory
# Relative to app/backend/ or absolute path
CRYPTO_PATH=../network/organizations

# Fabric Peer Endpoints (internal to host / server-side; NEVER exposed to browsers)
PEER_BANKA_ENDPOINT=localhost:10051
PEER_RBI_ENDPOINT=localhost:10052
PEER_BANKC_ENDPOINT=localhost:12051
PEER_MAS_ENDPOINT=localhost:12052

# Automated Background Expiry Watcher Configuration
EXPIRY_WATCHER_INTERVAL_MS=5000
EXPIRY_WATCHER_MSP=RBI-MSP

# Offline / Demo Simulation Mode
# Set to 'true' to force in-memory simulation even if Fabric containers are offline
MOCK_FABRIC=false
