# ==============================================================================
# AtomicBridge Frontend Environment Configuration
# ==============================================================================

# Backend API URL (Optional)
# If left empty, the frontend dynamically uses the browser's current host on port 4000:
# http://<current-hostname-or-lan-ip>:4000
#
# To explicitly bind to a specific address or public tunnel, configure below:
# VITE_BACKEND_URL=http://localhost:4000
VITE_BACKEND_URL=
